#!/usr/bin/env bash
set -euo pipefail

invocation_dir=$PWD
browser_tests=false
if [[ ${1-} == --browser ]]; then
  browser_tests=true
  shift
  artifact=browser
  repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
elif [[ ${1-} ]]; then
  artifact=$1
else
  echo "a test binary or --browser is required" >&2
  exit 2
fi
if ! $browser_tests && [[ $artifact == */target/* ]]; then
  repo_root=${artifact%%/target/*}
elif ! $browser_tests; then
  repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fi
binary_name=${artifact##*/}
binary_name=${binary_name%.wasm}
binary_name=${binary_name%-*}
server_pid=
server_input=
ca_file=
export PAPO_TEST_PID=$$
export PAPO_TEST_SERVER=${PAPO_TEST_SERVER-ergo}
if [[ -z ${PAPO_TEST_PROFILE-} ]]; then
  if [[ $PAPO_TEST_SERVER == ergo ]]; then
    export PAPO_TEST_PROFILE=ergo-default
  else
    export PAPO_TEST_PROFILE=$PAPO_TEST_SERVER
  fi
fi

# The EXIT trap is the only caller.
# shellcheck disable=SC2329
cleanup() {
  status=$?
  trap - EXIT
  if [[ -n $server_input ]]; then
    exec {server_input}>&-
    wait "$server_pid" || true
  fi
  if [[ -n $ca_file ]]; then
    rm -f "$invocation_dir/$ca_file"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

start_server() {
  if [[ -v PAPO_TEST_PLAINTEXT && -v PAPO_TEST_TLS && -v PAPO_TEST_WS && -v PAPO_TEST_WSS && -v PAPO_TEST_CA ]]; then
    export PAPO_TEST_PLAINTEXT PAPO_TEST_TLS PAPO_TEST_WS PAPO_TEST_WSS PAPO_TEST_CA
    return
  fi
  if [[ -v PAPO_TEST_PLAINTEXT || -v PAPO_TEST_TLS || -v PAPO_TEST_WS || -v PAPO_TEST_WSS || -v PAPO_TEST_CA ]]; then
    echo "PAPO test server variables must be set together" >&2
    exit 2
  fi

  if [[ -n ${PAPO_TEST_SERVER_BIN-} ]]; then
    helper=$PAPO_TEST_SERVER_BIN
  else
    cargo build --quiet --manifest-path "$repo_root/Cargo.toml" \
      -p papo-test-server --bin papo-test-server
    helper=$repo_root/target/debug/papo-test-server
  fi
  coproc PAPO_SERVER { "$helper"; }
  server_output=${PAPO_SERVER[0]}
  server_input=${PAPO_SERVER[1]}
  server_pid=$PAPO_SERVER_PID
  IFS= read -r PAPO_TEST_PLAINTEXT <&"$server_output"
  IFS= read -r PAPO_TEST_TLS <&"$server_output"
  IFS= read -r PAPO_TEST_WS <&"$server_output"
  IFS= read -r PAPO_TEST_WSS <&"$server_output"
  IFS= read -r host_ca <&"$server_output"
  IFS= read -r PAPO_TEST_BOUNCER_USER <&"$server_output"
  IFS= read -r PAPO_TEST_BOUNCER_PASSWORD <&"$server_output"
  IFS= read -r PAPO_TEST_BOUNCER_CONFIG <&"$server_output"
  IFS= read -r PAPO_TEST_UPSTREAM <&"$server_output"
  PAPO_TEST_CA=$host_ca
  if [[ $artifact == *.wasm ]]; then
    mkdir -p "$invocation_dir/target/papo-test-server"
    host_ca_copy=$(mktemp "$invocation_dir/target/papo-test-server/ca.XXXXXX.pem")
    cp "$host_ca" "$host_ca_copy"
    ca_file=${host_ca_copy#"$invocation_dir/"}
    PAPO_TEST_CA=$ca_file
  fi
  export PAPO_TEST_PLAINTEXT PAPO_TEST_TLS PAPO_TEST_WS PAPO_TEST_WSS PAPO_TEST_CA
  if [[ -n $PAPO_TEST_BOUNCER_USER && -n $PAPO_TEST_BOUNCER_PASSWORD && -n $PAPO_TEST_BOUNCER_CONFIG && -n $PAPO_TEST_UPSTREAM ]]; then
    export PAPO_TEST_BOUNCER_USER PAPO_TEST_BOUNCER_PASSWORD PAPO_TEST_BOUNCER_CONFIG PAPO_TEST_UPSTREAM
  elif [[ -n $PAPO_TEST_BOUNCER_USER || -n $PAPO_TEST_BOUNCER_PASSWORD || -n $PAPO_TEST_BOUNCER_CONFIG || -n $PAPO_TEST_UPSTREAM ]]; then
    echo "PAPO test bouncer variables must be set together" >&2
    exit 2
  fi
}

if [[ $binary_name == live_* || $binary_name == papo ]]; then
  start_server
fi

if $browser_tests; then
  export PAPO_BROWSER_ACCOUNT=papo-browser-$PAPO_TEST_PID
  export PAPO_BROWSER_PASSWORD=q7Hx-2mZp_9vLcT4wRfB
  start_server
  if [[ ! -d ${HOME-} ]]; then
    export HOME=$invocation_dir/target/browser-home
    mkdir -p "$HOME"
  fi
  export PAPO_BROWSER_WS=$PAPO_TEST_WS
  export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner
  manifest=crates/papo-core/tests/browser/Cargo.toml
  cargo test --manifest-path "$manifest" --target wasm32-unknown-unknown --features driver --locked --test node
  CI=1 cargo test --manifest-path "$manifest" --target wasm32-unknown-unknown --features driver --locked --test dedicated_worker
  CI=1 cargo test --manifest-path "$manifest" --target wasm32-unknown-unknown --features driver --locked --test shared_worker
  exit
fi

set +e
if [[ $artifact == *.wasm ]]; then
  wasmtime_args=(run --dir=.)
  wasmtime_args+=(--env PAPO_TEST_PID)
  if [[ $binary_name == live_* || $binary_name == papo ]]; then
    wasmtime_args+=(
      --env PAPO_TEST_PLAINTEXT
      --env PAPO_TEST_TLS
      --env PAPO_TEST_WS
      --env PAPO_TEST_WSS
      --env PAPO_TEST_CA
      --env PAPO_TEST_SERVER
      --env PAPO_TEST_PROFILE
    )
    if [[ -n ${PAPO_TEST_BOUNCER_USER-} ]]; then
      wasmtime_args+=(
        --env PAPO_TEST_BOUNCER_USER
        --env PAPO_TEST_BOUNCER_PASSWORD
        --env PAPO_TEST_BOUNCER_CONFIG
        --env PAPO_TEST_UPSTREAM
      )
    fi
  fi
  wasmtime_args+=(-S inherit-network -S allow-ip-name-lookup)
  if [[ $artifact == *wasm32-wasip3* ]]; then
    wasmtime_args+=(-S p3)
  fi
  (cd "$invocation_dir" && wasmtime "${wasmtime_args[@]}" "$@")
  status=$?
else
  "$@"
  status=$?
fi
set -e
exit "$status"
