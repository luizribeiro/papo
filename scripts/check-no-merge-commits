#!/usr/bin/env bash
set -euo pipefail

base=${1-}
if [[ -z "$base" ]]; then
  for candidate in refs/remotes/upstream/main refs/remotes/origin/main refs/heads/main; do
    if git rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null; then
      base=$candidate
      break
    fi
  done
fi

if [[ -z "$base" ]] || ! git rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
  echo "cannot find the main branch; pass its commit or ref as the first argument" >&2
  exit 2
fi

merges=$(git rev-list --min-parents=2 "${base}..HEAD")
if [[ -n "$merges" ]]; then
  echo "merge commits are not allowed between $base and HEAD:" >&2
  while IFS= read -r merge; do
    git show --no-patch --format='  %h %s' "$merge" >&2
  done <<<"$merges"
  exit 1
fi
