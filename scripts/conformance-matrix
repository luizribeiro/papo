#!/usr/bin/env python3
"""Run live conformance tests and generate the server support matrix."""

import argparse
import os
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "crates/papo-conformance/scripts"))

from summary import summarize  # noqa: E402


SERVERS = ("ergo", "unrealircd")


def run_server(server):
    """Run one server's suite and return statuses from its JSON stream."""
    command = [
        "cargo",
        "test",
        "-p",
        "papo-conformance",
        "--test",
        "live_conformance",
        "--locked",
        "--",
        "--format",
        "json",
        "--test-threads=1",
    ]
    environment = dict(os.environ, PAPO_TEST_SERVER=server)
    result = subprocess.run(
        command,
        cwd=ROOT,
        env=environment,
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    )
    statuses = summarize(result.stdout.splitlines())
    if not statuses:
        raise RuntimeError(f"{server} conformance run produced no scenario results")
    return statuses


def render(results):
    """Render a stable Markdown matrix with known-failure footnotes."""
    scenarios = sorted(set().union(*(statuses.keys() for statuses in results.values())))
    footnotes = []

    def cell(server, scenario):
        status = results[server].get(scenario, "failed")
        if status == "passed":
            return "✓"
        if status.startswith("ignored"):
            return "—"
        if status == "expected-failure":
            reason = KNOWN_FAILURE_REASONS[(server, scenario)]
            footnotes.append((server, scenario, reason))
            return f"⚠ [^{len(footnotes)}]"
        return "✗"

    lines = [
        "# IRC server conformance matrix\n",
        "Generated by `scripts/conformance-matrix`; do not edit by hand.\n",
        "| Scenario | Ergo | UnrealIRCd |",
        "| --- | :---: | :---: |",
    ]
    for scenario in scenarios:
        lines.append(
            f"| `{scenario}` | {cell('ergo', scenario)} | {cell('unrealircd', scenario)} |"
        )
    lines.extend(
        [
            "",
            "✓ pass · — not advertised or unavailable setup · ⚠ known failure · ✗ fail",
        ]
    )
    for number, (server, scenario, reason) in enumerate(footnotes, 1):
        lines.append(f"[^{number}]: `{server}` / `{scenario}`: {reason}")
    return "\n".join(lines) + "\n"


def load_known_failures():
    """Read reasons from the suite's validated TOML-shaped files."""
    import tomllib

    reasons = {}
    directory = ROOT / "crates/papo-conformance/known-failures"
    for server in SERVERS:
        with (directory / f"{server}.toml").open("rb") as source:
            for scenario, entry in tomllib.load(source).items():
                reasons[(server, scenario)] = entry["reason"]
    return reasons


KNOWN_FAILURE_REASONS = load_known_failures()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        default=ROOT / "docs/conformance-matrix.md",
    )
    arguments = parser.parse_args()
    results = {server: run_server(server) for server in SERVERS}
    arguments.output.parent.mkdir(parents=True, exist_ok=True)
    arguments.output.write_text(render(results))


if __name__ == "__main__":
    main()
