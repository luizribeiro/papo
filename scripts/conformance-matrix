#!/usr/bin/env python3
"""Run live conformance tests and generate the server support matrix."""

import argparse
import os
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "crates/papo-conformance/scripts"))

from summary import summarize_with_evidence  # noqa: E402


PROFILES = (
    "ergo-default",
    "ergo-persistent",
    "soju-ergo",
    "inspircd",
    "solanum",
    "unrealircd",
)
PROFILE_LABELS = {
    "ergo-default": "Ergo default",
    "ergo-persistent": "Ergo persistent",
    "soju-ergo": "soju + Ergo",
    "inspircd": "InspIRCd",
    "solanum": "Solanum",
    "unrealircd": "UnrealIRCd",
}
KIND_LABELS = {
    "server-bug": "server bug",
    "not-implemented": "not implemented",
    "spec-ambiguity": "spec ambiguity",
    "fixture-limit": "fixture limit",
}


def run_profile(profile):
    """Run one deployment profile and return statuses from its JSON stream."""
    command = [
        "cargo",
        "test",
        "-p",
        "papo-conformance",
        "--test",
        "live_conformance",
        "--locked",
        "--",
        "--format",
        "json",
        "--test-threads=1",
    ]
    environment = dict(os.environ, PAPO_TEST_PROFILE=profile)
    result = subprocess.run(
        command,
        cwd=ROOT,
        env=environment,
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    )
    statuses, evidence = summarize_with_evidence(result.stdout.splitlines())
    if not statuses:
        raise RuntimeError(f"{profile} conformance run produced no scenario results")
    return statuses, evidence


def render(results, evidence=None):
    """Render a stable Markdown matrix with known-failure footnotes."""
    evidence = evidence or {}
    scenarios = sorted(set().union(*(statuses.keys() for statuses in results.values())))
    footnotes = []

    def cell(profile, scenario):
        status = results[profile].get(scenario, "failed")
        if status == "passed":
            if scenario in evidence.get(profile, {}):
                footnotes.append((profile, scenario, None, evidence[profile][scenario]))
                return f"✓ [^{len(footnotes)}]"
            return "✓"
        if status.startswith("ignored"):
            return "—"
        if status == "expected-failure":
            entry = KNOWN_FAILURES[(profile, scenario)]
            footnotes.append((profile, scenario, entry["kind"], entry["reason"]))
            return f"⚠ [^{len(footnotes)}]"
        return "✗"

    lines = [
        "# IRC server conformance matrix\n",
        "Generated by `scripts/conformance-matrix`; do not edit by hand.\n",
        "| Scenario | " + " | ".join(PROFILE_LABELS[profile] for profile in PROFILES) + " |",
        "| --- | " + " | ".join(":---:" for _ in PROFILES) + " |",
    ]
    for scenario in scenarios:
        lines.append(
            f"| `{scenario}` | "
            + " | ".join(cell(profile, scenario) for profile in PROFILES)
            + " |"
        )
    lines.extend(
        [
            "",
            "✓ pass · — not advertised or unavailable setup · ⚠ known failure · ✗ fail",
        ]
    )
    for number, (profile, scenario, kind, reason) in enumerate(footnotes, 1):
        if kind is None:
            lines.append(f"[^{number}]: `{profile}` / `{scenario}` — {reason}")
        else:
            lines.append(
                f"[^{number}]: ⚠ {KIND_LABELS[kind]}: "
                f"`{profile}` / `{scenario}` — {reason}"
            )
    return "\n".join(lines) + "\n"


def load_known_failures():
    """Read classified exceptions from the suite's validated TOML files."""
    import tomllib

    failures = {}
    directory = ROOT / "crates/papo-conformance/known-failures"
    for profile in PROFILES:
        path = directory / f"{profile}.toml"
        if not path.exists():
            continue
        with path.open("rb") as source:
            for scenario, entry in tomllib.load(source).items():
                failures[(profile, scenario)] = entry
    return failures


KNOWN_FAILURES = load_known_failures()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        default=ROOT / "docs/conformance-matrix.md",
    )
    arguments = parser.parse_args()
    runs = {profile: run_profile(profile) for profile in PROFILES}
    results = {profile: run[0] for profile, run in runs.items()}
    evidence = {profile: run[1] for profile, run in runs.items()}
    arguments.output.parent.mkdir(parents=True, exist_ok=True)
    arguments.output.write_text(render(results, evidence))


if __name__ == "__main__":
    main()
