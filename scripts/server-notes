#!/usr/bin/env python3
"""Generate notes about server exceptions and fixture patches."""

import argparse
import pathlib
import tomllib


ROOT = pathlib.Path(__file__).resolve().parent.parent
FAILURES = ROOT / "crates/papo-conformance/known-failures"
PATCH_INDEX = ROOT / "nix/fixture-patches.toml"
OBSERVATIONS = ROOT / "crates/papo-conformance/server-observations.toml"
PROFILE_LABELS = {
    "ergo-default": "Ergo default",
    "ergo-persistent": "Ergo persistent",
    "soju-ergo": "soju + Ergo",
    "inspircd": "InspIRCd",
    "solanum": "Solanum",
    "unrealircd": "UnrealIRCd",
}
PROFILES = tuple(PROFILE_LABELS)
KINDS = {
    "server-bug": "Server bugs",
    "not-implemented": "Unimplemented features",
    "spec-ambiguity": "Specification ambiguities",
    "fixture-limit": "Fixture limits",
}
OBSERVATION_LABELS = {
    "history-end": "Chat history end",
    "connect-line-length": "Connect line length",
    "labeled-response": "Labeled response availability",
    "statusmsg-reference-audience": "Status-message reference audience",
}


def require_fields(name, record, fields):
    """Reject absent, empty, or incorrectly typed string fields."""
    for field in fields:
        if not isinstance(record.get(field), str) or not record[field].strip():
            raise ValueError(f"{name} is missing non-empty string {field!r}")


def load_failures(directory=FAILURES):
    """Load and validate every known-failure profile."""
    profiles = {}
    for path in sorted(directory.glob("*.toml")):
        entries = tomllib.loads(path.read_text())
        for scenario, entry in entries.items():
            require_fields(
                f"{path.name}:{scenario}",
                entry,
                ("reason", "kind", "spec", "evidence", "server_version"),
            )
            if entry["kind"] not in KINDS:
                raise ValueError(
                    f"{path.name}:{scenario} has unknown kind {entry['kind']!r}"
                )
        profiles[path.stem] = entries
    unknown = sorted(
        profile
        for profile, entries in profiles.items()
        if profile not in PROFILES and entries
    )
    if unknown:
        raise ValueError("profiles without labels: " + ", ".join(unknown))
    missing = sorted(set(PROFILES) - set(profiles))
    if missing:
        raise ValueError("profiles without files: " + ", ".join(missing))
    return {profile: profiles[profile] for profile in PROFILES}


def load_patches(index=PATCH_INDEX, directory=None):
    """Load patch descriptions and require an exact index of nix patches."""
    directory = directory or index.parent
    patches = tomllib.loads(index.read_text())
    files = {path.name for path in directory.glob("*.patch")}
    if set(patches) != files:
        missing = sorted(files - set(patches))
        stale = sorted(set(patches) - files)
        raise ValueError(f"patch index mismatch; missing={missing}, stale={stale}")
    for filename, entry in patches.items():
        require_fields(filename, entry, ("profile", "what", "why", "evidence"))
        if not isinstance(entry.get("server_bug"), bool):
            raise ValueError(f"{filename} is missing boolean 'server_bug'")
        if entry["profile"] not in PROFILE_LABELS:
            raise ValueError(f"{filename} has unknown profile {entry['profile']!r}")
    return patches


def load_observations(path=OBSERVATIONS):
    """Load versioned wire observations for every deployment profile."""
    observations = tomllib.loads(path.read_text())
    if set(observations) != set(PROFILES):
        raise ValueError("observations must describe every profile")
    for profile, topics in observations.items():
        unknown = set(topics) - set(OBSERVATION_LABELS)
        if unknown:
            raise ValueError(f"{profile} has unknown observations: {sorted(unknown)}")
        for topic, entry in topics.items():
            require_fields(f"{profile}:{topic}", entry, ("finding", "evidence", "server_version"))
    return observations


def render(profiles, patches, observations):
    """Render stable Markdown grouped by profile and exception kind."""
    lines = [
        "# IRC server notes\n",
        "Generated by `scripts/server-notes`; do not edit by hand.\n",
        "Wire excerpts use `C:` for client lines and `S:` for server lines.\n",
    ]
    for profile, entries in profiles.items():
        lines.append(f"## {PROFILE_LABELS[profile]}")
        for kind, heading in KINDS.items():
            matching = [
                (scenario, entry)
                for scenario, entry in entries.items()
                if entry["kind"] == kind
            ]
            empty = " (none recorded)" if not matching else ""
            lines.append(f"\n### {heading}{empty}")
            for scenario, entry in matching:
                lines.append(
                    f"- `{scenario}` (`{entry['server_version']}`) — "
                    f"{entry['reason']} ([spec]({entry['spec']})). "
                    f"Evidence: `{entry['evidence']}`"
                )
        lines.append("\n### Observations")
        for topic, entry in observations[profile].items():
            lines.append(
                f"- **{OBSERVATION_LABELS[topic]}** (`{entry['server_version']}`) — "
                f"{entry['finding']} Evidence: `{entry['evidence']}`"
            )
        matching = [
            (filename, entry)
            for filename, entry in patches.items()
            if entry["profile"] == profile
        ]
        empty = " (none)" if not matching else ""
        lines.append(f"\n### Fixture patches{empty}")
        for filename, entry in matching:
            server_bug = "yes" if entry["server_bug"] else "no"
            lines.append(
                f"- `nix/{filename}` — {entry['what']} Why: {entry['why']} "
                f"Evidence: `{entry['evidence']}` Server bug: **{server_bug}**."
            )
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=pathlib.Path, default=ROOT / "docs/server-notes.md")
    arguments = parser.parse_args()
    arguments.output.write_text(render(load_failures(), load_patches(), load_observations()))


if __name__ == "__main__":
    main()
