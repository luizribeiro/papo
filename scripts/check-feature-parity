#!/usr/bin/env bash
set -euo pipefail
outputs=$(mktemp -d)
trap 'rm -rf "$outputs"' EXIT
transcript() { local package=$1 test=$2 name=$3 marker=$4; shift 4
  CARGO_TERM_COLOR=never cargo test --quiet --locked -p "$package" --test "$test" \
    --no-default-features "$@" \
    "$name" -- --exact --nocapture \
    | sed -n "/${marker}_BEGIN/,/${marker}_END/p"
}
compare() { local package=$1 test=$2 name=$3 marker=$4
  transcript "$@" >"$outputs/$test.stable"
  transcript "$@" --features unstable >"$outputs/$test.unstable"
  if [ ! -s "$outputs/$test.stable" ]; then
    echo "$package's $test transcript is empty" >&2
    exit 1
  fi
  diff -u "$outputs/$test.stable" "$outputs/$test.unstable"
}
cd "$(dirname "$0")/.."
listed=$(cargo test --quiet --locked -p papo-core --lib --no-default-features -- --list)
if ! grep -q '^stable_build_tests::' <<<"$listed"; then
  echo "papo-core's stable-only unit tests are not listed" >&2
  exit 1
fi
compare papo-core feature_parity disabled_extensions_match_stable_behavior PAPO_FEATURE_PARITY
compare papo handle_parity stable_and_unstable_replay_identically PAPO_HANDLE_PARITY
