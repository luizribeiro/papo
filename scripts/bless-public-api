#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

nightly_cargo=
while IFS= read -r directory; do
  candidate="$directory/cargo"
  if [[ -x "$candidate" ]] && "$candidate" --version | grep -q nightly; then
    nightly_cargo=$candidate
    break
  fi
done < <(printf '%s' "$PATH" | tr : '\n')
if [[ -z "$nightly_cargo" ]]; then
  echo "nightly cargo is unavailable; enter the flake dev shell" >&2
  exit 1
fi

nightly_bin=$(dirname "$nightly_cargo")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

generate() {
  local package=$1
  local crate=$2
  local features=$3
  local snapshot=$4
  local target=$5
  local actual="$work/actual"
  CARGO_INCREMENTAL=0 \
    RUSTC="$nightly_bin/rustc" \
    RUSTDOC="$nightly_bin/rustdoc" \
    "$nightly_cargo" rustdoc \
      -p "$package" --no-default-features --features "$features" --lib --target-dir "$target" \
      -- -Z unstable-options --output-format json
  if [[ "$package" == papo ]]; then
    cargo public-api \
      --rustdoc-json "$target/doc/$crate.json" \
      --color=never -s | PAPO_PUBLIC_API_FACADE=1 bash nix/normalize-public-api.sh > "$actual"
  else
    cargo public-api \
      --rustdoc-json "$target/doc/$crate.json" \
      --color=never -s | bash nix/normalize-public-api.sh > "$actual"
  fi
  mv "$actual" "$snapshot"
}

stable=websocket,tls-aws-lc,tls-ring
generate papo-proto papo_proto '' crates/papo-proto/public-api.txt "$work/papo-proto"
generate papo-core papo_core '' crates/papo-core/public-api.txt "$work/papo-core-stable"
generate papo-core papo_core unstable crates/papo-core/public-api-unstable.txt "$work/papo-core-unstable"
generate papo papo "$stable" crates/papo/public-api.txt "$work/papo-stable"
generate papo papo "$stable,unstable" crates/papo/public-api-unstable.txt "$work/papo-unstable"
generate papo-bot papo_bot '' crates/papo-bot/public-api.txt "$work/papo-bot"
