#!/usr/bin/env python3
"""Generate papo's IRCv3 specification support table."""

import argparse
import pathlib
import re
import sys
import tomllib


ROOT = pathlib.Path(__file__).resolve().parent.parent
DATA = ROOT / "scripts/ircv3-support.toml"
CAPS = ROOT / "crates/papo-core/src/cap.rs"
CHECKLIST = ROOT / "crates/papo-conformance/coverage-checklist.toml"
COVERAGE = ROOT / "docs/conformance-coverage.md"
OUTPUT = ROOT / "docs/ircv3-support.md"
UNSUPPORTED_GROUP = "Deprecated or unsupported"
SUPPORT = dict(Default="Yes", Automatic="Opt-in", Never="No", Superseded="Yes", OptIn="Unstable")
ENUMS = {"Authorship", "ConnectErrorKind", "Event", "Extban", "Feature"}
REGISTRY_ENTRY = re.compile(
    r'^\s*(?:#\[cfg\(feature = "unstable"\)\]\s+)?(?:\[cap\]\s+)?'
    r'\w+\s*=.*?name: "(?P<name>[^"]+)"; aliases: \[[^]]*\]; '
    r'request: Request::(?P<request>\w+)',
    re.MULTILINE,
)


def load_registry(path=CAPS):
    registry = {
        match["name"]: match["request"]
        for match in REGISTRY_ENTRY.finditer(path.read_text())
    }
    if not registry:
        raise ValueError("capability registry contains no recognizable entries")
    return registry


def load_catalog(path=DATA):
    groups = tomllib.loads(path.read_text())["group"]
    valid = set(SUPPORT.values())
    for group in groups:
        for spec in group["specs"]:
            if group["title"] == UNSUPPORTED_GROUP and not spec.get("reason"):
                raise ValueError(f"{spec['name']} has no unsupported reason")
            if "support" in spec and spec["support"] not in valid:
                raise ValueError(f"invalid support value for {spec['name']}")
            if not spec.get("wire") and not spec.get("caps"):
                raise ValueError(f"{spec['name']} has no wire name")
    return groups


def live_coverage_ids(checklist=CHECKLIST, coverage=COVERAGE):
    known = set(tomllib.loads(checklist.read_text())["ids"])
    live = set()
    documented = set()
    for line in coverage.read_text().splitlines():
        match = re.match(r"\| `([^`]+)` \| (.*?) \|", line)
        if match:
            identifier, source = match.groups()
            documented.add(identifier)
            if source.startswith("`"):
                live.add(identifier)
    if known != documented:
        raise ValueError("conformance coverage is stale against its checklist")
    return known, live


def api_link(name):
    if name == "—":
        return name
    root, separator, member = name.partition("::")
    kind = "enum" if root in ENUMS else "struct"
    url = f"https://docs.rs/papo/latest/papo/{kind}.{root}.html"
    if separator:
        anchor = "variant" if root in ENUMS and member[0].isupper() else "method"
        url += f"#{anchor}.{member}"
    return f"[`{name}`]({url})"


def matches(identifier, pattern):
    return identifier.startswith(pattern) if pattern.endswith(".") else identifier == pattern


def render(groups, registry, known_coverage, live_coverage):
    listed = {
        cap
        for group in groups
        for spec in group["specs"]
        for cap in spec.get("caps", [])
    }
    if missing := set(registry) - listed:
        raise ValueError(f"capability catalog is missing: {', '.join(sorted(missing))}")
    if extra := listed - set(registry):
        raise ValueError(f"catalog names unknown capabilities: {', '.join(sorted(extra))}")

    lines = [
        "# IRCv3 support\n",
        "Generated by `scripts/ircv3-support`; do not edit by hand.\n",
        "`Yes` is enabled by default. `Opt-in` needs `enable(Feature::…)`, a builder "
        "setting, or a cargo feature. `Unstable` also needs the `unstable` crate feature.\n",
    ]
    for group in groups:
        lines.append(f"## {group['title']}\n")
        if group["title"] == UNSUPPORTED_GROUP:
            lines.extend(
                [
                    "| Specification | Capability, tag, or token | Notes |",
                    "| --- | --- | --- |",
                ]
            )
            for spec in group["specs"]:
                wire = spec.get("wire") or ", ".join(spec["caps"])
                lines.append(
                    f"| [{spec['name']}]({spec['url']}) | `{wire}` | {spec['reason']} |"
                )
            lines.append("")
            continue
        lines.extend(
            [
                "| Specification | Capability, tag, or token | Support | papo API | Live conformance |",
                "| --- | --- | :---: | --- | :---: |",
            ]
        )
        for spec in group["specs"]:
            policies = [SUPPORT[registry[cap]] for cap in spec.get("caps", [])]
            support = spec.get("support") or max(
                policies, key=("No", "Opt-in", "Unstable", "Yes").index
            )
            pattern = spec.get("coverage")
            if pattern and not any(matches(item, pattern) for item in known_coverage):
                raise ValueError(f"unknown coverage mapping for {spec['name']}: {pattern}")
            covered = pattern and any(matches(item, pattern) for item in live_coverage)
            coverage_cell = "[Yes](conformance-matrix.md)" if covered else "No"
            wire = spec.get("wire") or ", ".join(spec["caps"])
            lines.append(
                f"| [{spec['name']}]({spec['url']}) | `{wire}` | {support} | "
                f"{api_link(spec['api'])} | {coverage_cell} |"
            )
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=pathlib.Path, default=OUTPUT)
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    known, live = live_coverage_ids()
    generated = render(load_catalog(), load_registry(), known, live)
    if arguments.check:
        if not arguments.output.exists() or arguments.output.read_text() != generated:
            print(f"{arguments.output} is stale; run scripts/ircv3-support", file=sys.stderr)
            raise SystemExit(1)
    else:
        arguments.output.parent.mkdir(parents=True, exist_ok=True)
        arguments.output.write_text(generated)


if __name__ == "__main__":
    main()
