#!/usr/bin/env python3
"""Generate checklist coverage from scenario metadata and server results."""

import argparse
import os
import pathlib
import runpy
import subprocess
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
MATRIX_TOOL = runpy.run_path(ROOT / "scripts/conformance-matrix")
PROFILES = MATRIX_TOOL["PROFILES"]
PROFILE_LABELS = tuple(MATRIX_TOOL["PROFILE_LABELS"][profile] for profile in PROFILES)
def load_declarations(lines):
    declarations = {}
    for record in MATRIX_TOOL["records"](lines):
        if record.get("type") != "covers":
            continue
        scenario = record.get("name")
        if scenario in declarations:
            raise ValueError(f"scenario {scenario!r} printed coverage more than once")
        declarations[scenario] = record.get("behaviors", [])
    return declarations
def collect_declarations():
    environment = dict(os.environ, PAPO_CONFORMANCE_DESCRIBE="1")
    result = subprocess.run(
        ["cargo", "test", "--quiet", "--locked", "-p", "papo-conformance",
         "--test", "live_conformance", "--", "--nocapture", "--test-threads=1"],
        cwd=ROOT,
        env=environment,
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    lines = result.stdout.splitlines()
    declarations = load_declarations(lines)
    missing = MATRIX_TOOL["missing_scenario_statuses"](lines, declarations)
    if missing:
        raise RuntimeError("scenarios produced no coverage: " + ", ".join(missing))
    return declarations
def collect_wire_declarations(path):
    declarations = tomllib.loads(path.read_text())["tests"]
    by_target = {}
    for name in declarations:
        target, separator, test = name.partition("::")
        if not separator or not target or not test:
            raise ValueError(f"wire test name must be TARGET::TEST: {name}")
        by_target.setdefault(target, set()).add(test)
    for target, expected in by_target.items():
        result = subprocess.run(
            ["cargo", "test", "--quiet", "--locked", "-p", "papo-testing",
             "--test", target, "--", "--list", "--format", "terse"],
            cwd=ROOT,
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
        available = {
            line.removesuffix(": test") for line in result.stdout.splitlines()
            if line.endswith(": test")
        }
        missing = sorted(expected - available)
        if missing:
            raise RuntimeError(
                f"{target} wire tests do not exist: " + ", ".join(missing)
            )
    return declarations
def load_matrix(path):
    statuses = {}
    for line in path.read_text().splitlines():
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != len(PROFILES) + 1 or not cells[0].startswith("`"):
            continue
        statuses[cells[0].strip("`")] = dict(zip(PROFILES, cells[1:]))
    return statuses
def validate(checklist, declarations, wire_declarations, waivers, statuses):
    if len(checklist) != len(set(checklist)):
        raise ValueError("coverage checklist contains duplicate ids")
    known = set(checklist)
    scenario_ids = {
        behavior for behaviors in declarations.values() for behavior in behaviors
    }
    wire_ids = {
        behavior for behaviors in wire_declarations.values() for behavior in behaviors
    }
    declared = scenario_ids | wire_ids
    unknown = sorted((declared | set(waivers)) - known)
    if unknown:
        raise ValueError("unknown checklist ids: " + ", ".join(unknown))
    empty = sorted(name for name, behaviors in declarations.items() if not behaviors)
    if empty:
        raise ValueError("scenarios without covers metadata: " + ", ".join(empty))
    empty_wire = sorted(
        name for name, behaviors in wire_declarations.items() if not behaviors
    )
    if empty_wire:
        raise ValueError("wire tests without covers metadata: " + ", ".join(empty_wire))
    stale = sorted(declared & set(waivers))
    if stale:
        raise ValueError("covered ids still have waivers: " + ", ".join(stale))
    missing = sorted(known - declared - set(waivers))
    if missing:
        raise ValueError(
            "checklist ids without a scenario, wire test, or waiver: "
            + ", ".join(missing)
        )
    absent = sorted(set(declarations) - set(statuses))
    if absent:
        raise ValueError("scenarios missing from conformance matrix: " + ", ".join(absent))
    blank = sorted(identifier for identifier, reason in waivers.items() if not reason.strip())
    if blank:
        raise ValueError("waivers without reasons: " + ", ".join(blank))
def combined_status(scenarios, statuses, profile):
    cells = [statuses[scenario][profile] for scenario in scenarios]
    for marker in ("✗", "⚠", "✓", "—"):
        if any(cell.startswith(marker) for cell in cells):
            return marker
    raise ValueError(f"unknown matrix status for {scenarios!r}")
def render(checklist, declarations, wire_declarations, waivers, statuses):
    by_behavior = {identifier: [] for identifier in checklist}
    for scenario, behaviors in declarations.items():
        for behavior in behaviors:
            by_behavior[behavior].append(scenario)
    wire_by_behavior = {identifier: [] for identifier in checklist}
    for test, behaviors in wire_declarations.items():
        for behavior in behaviors:
            wire_by_behavior[behavior].append(test)
    lines = [
        "# IRC behavior coverage\n",
        "Generated by `scripts/conformance-coverage`; do not edit by hand.\n",
        "| Checklist id | Scenario, wire test, or waiver | "
        + " | ".join(PROFILE_LABELS)
        + " |",
        "| --- | --- | " + " | ".join(":---:" for _ in PROFILES) + " |",
    ]
    for identifier in checklist:
        scenarios = sorted(by_behavior[identifier])
        wire_tests = sorted(wire_by_behavior[identifier])
        if wire_tests:
            source = ", ".join(f"Wire test `{test}`" for test in wire_tests)
            cells = ["✓"] * len(PROFILES)
        elif scenarios:
            source = ", ".join(f"`{scenario}`" for scenario in scenarios)
            cells = [combined_status(scenarios, statuses, profile) for profile in PROFILES]
        else:
            source = "Waiver: " + waivers[identifier].replace("|", "\\|")
            cells = ["—"] * len(PROFILES)
        lines.append(f"| `{identifier}` | {source} | " + " | ".join(cells) + " |")
    lines.append(
        "\nWire tests are profile-independent. "
        "✓ pass · — unavailable or waived · ⚠ known failure · ✗ fail"
    )
    return "\n".join(lines) + "\n"

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=pathlib.Path, default=ROOT / "docs/conformance-coverage.md")
    arguments = parser.parse_args()
    checklist = tomllib.loads((ROOT / "crates/papo-conformance/coverage-checklist.toml").read_text())["ids"]
    wire_declarations = collect_wire_declarations(
        ROOT / "crates/papo-conformance/coverage-wire-tests.toml"
    )
    waivers = tomllib.loads((ROOT / "crates/papo-conformance/coverage-waivers.toml").read_text())["waivers"]
    declarations = collect_declarations()
    statuses = load_matrix(ROOT / "docs/conformance-matrix.md")
    validate(checklist, declarations, wire_declarations, waivers, statuses)
    arguments.output.write_text(
        render(checklist, declarations, wire_declarations, waivers, statuses)
    )

if __name__ == "__main__":
    main()
