#!/usr/bin/env python3
"""Generate checklist coverage from scenario metadata and server results."""

import argparse
import pathlib
import runpy
import subprocess
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
MATRIX_TOOL = runpy.run_path(ROOT / "scripts/conformance-matrix")
PROFILES = MATRIX_TOOL["PROFILES"]
PROFILE_LABELS = tuple(MATRIX_TOOL["PROFILE_LABELS"][profile] for profile in PROFILES)
def load_declarations(text):
    declarations = {}
    for line in text.splitlines():
        scenario, separator, behavior = line.partition("\t")
        if not scenario or not separator:
            raise ValueError(f"invalid coverage row: {line!r}")
        declarations.setdefault(scenario, [])
        if behavior and behavior not in declarations[scenario]:
            declarations[scenario].append(behavior)
    return declarations
def collect_declarations():
    result = subprocess.run(
        ["cargo", "run", "--quiet", "--locked", "-p", "papo-conformance",
         "--bin", "conformance-coverage"],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return load_declarations(result.stdout)
def load_matrix(path):
    statuses = {}
    for line in path.read_text().splitlines():
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) != len(PROFILES) + 1 or not cells[0].startswith("`"):
            continue
        statuses[cells[0].strip("`")] = dict(zip(PROFILES, cells[1:]))
    return statuses
def validate(checklist, declarations, waivers, statuses):
    if len(checklist) != len(set(checklist)):
        raise ValueError("coverage checklist contains duplicate ids")
    known = set(checklist)
    declared = {
        behavior for behaviors in declarations.values() for behavior in behaviors
    }
    unknown = sorted((declared | set(waivers)) - known)
    if unknown:
        raise ValueError("unknown checklist ids: " + ", ".join(unknown))
    empty = sorted(name for name, behaviors in declarations.items() if not behaviors)
    if empty:
        raise ValueError("scenarios without covers metadata: " + ", ".join(empty))
    stale = sorted(declared & set(waivers))
    if stale:
        raise ValueError("covered ids still have waivers: " + ", ".join(stale))
    missing = sorted(known - declared - set(waivers))
    if missing:
        raise ValueError("checklist ids without a scenario or waiver: " + ", ".join(missing))
    absent = sorted(set(declarations) - set(statuses))
    if absent:
        raise ValueError("scenarios missing from conformance matrix: " + ", ".join(absent))
    blank = sorted(identifier for identifier, reason in waivers.items() if not reason.strip())
    if blank:
        raise ValueError("waivers without reasons: " + ", ".join(blank))
def combined_status(scenarios, statuses, profile):
    cells = [statuses[scenario][profile] for scenario in scenarios]
    for marker in ("✗", "⚠", "✓", "—"):
        if any(cell.startswith(marker) for cell in cells):
            return marker
    raise ValueError(f"unknown matrix status for {scenarios!r}")
def render(checklist, declarations, waivers, statuses):
    by_behavior = {identifier: [] for identifier in checklist}
    for scenario, behaviors in declarations.items():
        for behavior in behaviors:
            by_behavior[behavior].append(scenario)
    lines = [
        "# IRC behavior coverage\n",
        "Generated by `scripts/conformance-coverage`; do not edit by hand.\n",
        "| Checklist id | Scenario or waiver | " + " | ".join(PROFILE_LABELS) + " |",
        "| --- | --- | " + " | ".join(":---:" for _ in PROFILES) + " |",
    ]
    for identifier in checklist:
        scenarios = sorted(by_behavior[identifier])
        if scenarios:
            source = ", ".join(f"`{scenario}`" for scenario in scenarios)
            cells = [combined_status(scenarios, statuses, profile) for profile in PROFILES]
        else:
            source = "Waiver: " + waivers[identifier].replace("|", "\\|")
            cells = ["—"] * len(PROFILES)
        lines.append(f"| `{identifier}` | {source} | " + " | ".join(cells) + " |")
    lines.append("\n✓ pass · — unavailable or waived · ⚠ known failure · ✗ fail")
    return "\n".join(lines) + "\n"

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=pathlib.Path, default=ROOT / "docs/conformance-coverage.md")
    arguments = parser.parse_args()
    checklist = tomllib.loads((ROOT / "crates/papo-conformance/coverage-checklist.toml").read_text())["ids"]
    waivers = tomllib.loads((ROOT / "crates/papo-conformance/coverage-waivers.toml").read_text())["waivers"]
    declarations = collect_declarations()
    statuses = load_matrix(ROOT / "docs/conformance-matrix.md")
    validate(checklist, declarations, waivers, statuses)
    arguments.output.write_text(render(checklist, declarations, waivers, statuses))

if __name__ == "__main__":
    main()
