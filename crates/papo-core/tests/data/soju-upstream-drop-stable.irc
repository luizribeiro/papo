S: :bouncer.papo.test 353 * = #review :@alice papo-bouncer
S: :bouncer.papo.test 366 * #review :End of /NAMES list
S: :ergo.test 324 papo-bouncer #review +Cnt
S: :ergo.test 329 papo-bouncer #review 1793542051
# upstream disabled
